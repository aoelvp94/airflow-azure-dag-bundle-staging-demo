# Azurite's published development storage account. Not a real key.
# https://github.com/Azure/Azurite#connection-strings
AIRFLOW_CONN_WASB_DEFAULT={"conn_type":"wasb","extra":{"connection_string":"DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://wasb-proxy:10000/devstoreaccount1;"}}

# Two live bundles, same file set, two staging classes.
# WasbDagBundle takes prefix. WasbArchiveDagBundle takes archive_blob.
# There is no archive_blob flag on WasbDagBundle.
#
# Provider 15.2.1 does not ship either class. These classpaths are the
# vendored package, which re-exports
# airflow.providers.microsoft.azure.bundles.wasb.WasbDagBundle and
# airflow.providers.microsoft.azure.bundles.wasb.WasbArchiveDagBundle when
# those classes are installed. refresh_interval is long so a steady-state
# processor does not walk the prefix again while the benchmark is counting
# requests.
AIRFLOW__DAG_PROCESSOR__DAG_BUNDLE_CONFIG_LIST=[{"name":"wasb-per-object","classpath":"wasb_bundle.WasbDagBundle","kwargs":{"container_name":"dag-bundles","prefix":"dags/","wasb_conn_id":"wasb_default","refresh_interval":86400}},{"name":"wasb-archive","classpath":"wasb_bundle.WasbArchiveDagBundle","kwargs":{"container_name":"dag-bundles","archive_blob":"archive/dag-bundle.tar.gz","wasb_conn_id":"wasb_default","refresh_interval":86400}}]
